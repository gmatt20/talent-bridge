# Copy to .env and fill in. Never commit the real .env file.
AWS_PROFILE=AsherC
AWS_REGION=us-west-2

# Bedrock model id (inference profile). Swap to Claude Haiku or Nova Lite if DeepSeek R1 quality is insufficient.
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0

# Lower = more consistent JSON. Raise if outputs feel too robotic.
BEDROCK_TEMPERATURE=0.2
