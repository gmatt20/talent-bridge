# Copy to .env and fill in. Never commit the real .env file.

# ── Database ────────────────────────────────────────────────────────────
# "data-api"  → shared Aurora over signed HTTPS. Needs only AWS credentials
#               (`aws login --profile <yours>`), no VPC/SSH access.
# "psycopg"   → direct TCP. Needs either an SSH tunnel to the bastion or a
#               local Postgres. Set DATABASE_URL below.
DB_MODE=data-api

# Required when DB_MODE=data-api. Ask the team for the real values, or find
# them with: aws rds describe-db-clusters / aws secretsmanager list-secrets
RDS_CLUSTER_ARN=arn:aws:rds:us-west-2:<account-id>:cluster:<cluster-name>
RDS_SECRET_ARN=arn:aws:secretsmanager:us-west-2:<account-id>:secret:<secret-name>
RDS_DATABASE=talentbridge

# Required when DB_MODE=psycopg. Either a local Postgres:
#   postgresql:///talent_bridge
# or through the bastion tunnel on port 5433 (see ARCHITECTURE.md):
#   postgresql://<user>:<password>@127.0.0.1:5433/talentbridge
DATABASE_URL=postgresql:///talent_bridge

# ── App ─────────────────────────────────────────────────────────────────
# Signs auth tokens. Anyone who knows this can forge a token for any user —
# generate your own: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173

# ── AWS / Bedrock ───────────────────────────────────────────────────────
# Omit AWS_PROFILE to use your default credential chain.
# AWS_PROFILE=<your-profile>
AWS_REGION=us-west-2

# Nova Lite is regional (us-west-2 only). The DeepSeek R1 profile
# (us.deepseek.r1-v1:0) routes cross-region and hits an IAM deny on the team
# policy — don't use it unless that policy changes.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Lower = more consistent JSON. Raise if outputs feel too robotic.
BEDROCK_TEMPERATURE=0.2
