# true = use the in-browser mock API (src/api/mocks); false = call a real backend
VITE_USE_MOCKS=true

# Absolute backend origin to call when VITE_USE_MOCKS=false. Leave empty to use
# the Vite dev proxy against a local backend on :8000; set it to the deployed
# API (e.g. http://<host>:8000) to call that directly.
VITE_API_URL=

# OAuth client ID for "Sign in with Google" (Google Cloud Console → APIs &
# Services → Credentials, type "Web application", with this app's URL under
# "Authorized JavaScript origins"). It is public, not a secret. Leave empty to
# hide the Google button. Must match GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=
